{
  "manifest_version": 3,
  "name": "SF Downloader Integration",
  "version": "0.3.6",
  "description": "Integra downloads do navegador ao SF Downloader.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "downloads",
    "cookies",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17831/*"
  ],
  "background": {
    "scripts": [
      "youtube-url.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "youtube-url.js",
        "youtube.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "SF Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/sf-small.png",
      "128": "icons/sf-large.png"
    }
  },
  "icons": {
    "32": "icons/sf-small.png",
    "128": "icons/sf-large.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "integration@sfdownloader.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/sf-logo.svg"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ]
    }
  ]
}
